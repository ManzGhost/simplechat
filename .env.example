# Database Configuration (MongoDB Atlas in Production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/simplechat?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_characters_here
PORT=3000

# Frontend Backend Communication (Environment-Based)
# Local Development:
# VITE_API_URL=http://localhost:3000/api
# VITE_WS_URL=ws://localhost:3000/ws
#
# Production (Render / Custom Domain):
VITE_API_URL=https://your-backend-app.onrender.com/api
VITE_WS_URL=wss://your-backend-app.onrender.com/ws

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

